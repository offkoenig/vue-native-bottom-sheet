{
  "name": "vue-native-bottom-sheet",
  "version": "0.2.4",
  "description": "Production-ready bottom sheet for Vue 3 with native iOS/Android-like drag physics (velocity-based inertia, rubber-band, spring animations). Works standalone in any Vue 3 app and as a Nuxt 3 module.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/offkoenig/vue-native-bottom-sheet.git"
  },
  "homepage": "https://github.com/offkoenig/vue-native-bottom-sheet#readme",
  "bugs": {
    "url": "https://github.com/offkoenig/vue-native-bottom-sheet/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "nuxt3",
    "bottom-sheet",
    "drawer",
    "modal",
    "gesture",
    "spring-animation"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3.10.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/kit": "^3.14.0",
    "@nuxt/schema": "^3.14.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "tsup": "^8.3.0",
    "typescript": "5.6.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3",
    "vue": "^3.4.0",
    "vue-tsc": "^3.3.7"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json",
    "build:js": "tsup",
    "build:copy-sfc": "node scripts/copy-sfc.mjs",
    "build": "npm run typecheck && npm run build:types && npm run build:js && npm run build:copy-sfc",
    "demo:dev": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts"
  }
}
